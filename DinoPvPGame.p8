pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	-- add game states: "play" or "gameover"
	game_state = "play"
	
	player_init()
	att_init()
	ghost_init()
	tombstone_init()
	ui_init()
end

function _update()
	if game_state == "play" then
		player_update()
		att_update()
		ghost_update()
		handle_collisions()
		tombstone_update()
	elseif game_state == "gameover" then
		-- press x (button 5 / second action button) to restart
		if btnp(❎) then
			_init()
		end
	end
end

function _draw()
	cls(4)
	map()
	
	player_draw()
	att_draw()
	tombstone_draw()
	ghost_draw()
	ui_draw()
	
	-- overlay the game over screen if dead
	if game_state == "gameover" then
		draw_game_over()
	end
end
-->8
-- player functions

function player_init()	
	p1 = {
		x = 59,
		y = 110,
		speed = 0, -- current speed
		acc = 0.5, -- acceleration
		max_speed = 3,
		flip_h = false,
		current_spr = 1
	}
	
end

function player_update()
	
	if btn(⬅️) then
		-- then left btn is pressed
		p1.speed -= p1.acc
		p1.flip_h = true
	elseif btn(➡️) then
		-- then right btn is pressed
		p1.speed += p1.acc
		p1.flip_h = false
	else
		-- neither btn is pressed
	
		if p1.speed > 0 then
			-- moving right
			p1.speed = max(
				0, 
				p1.speed - 2 * p1.acc)
				
		elseif p1.speed < 0 then
			-- moving left
			p1.speed = min(
				0,
				p1.speed + 2 * p1.acc) 
			
		end
	end

 -- clamp speed between min and max
	p1.speed = mid(
		-p1.max_speed,
		p1.speed,
		p1.max_speed) 	
	
	p1.x += p1.speed
	
	-- stop at edges
	p1.x = mid(0, p1.x, 119)
	
	animate_player()
end

function player_draw()
	spr(
		p1.current_spr, 
		p1.x, p1.y, 
		1, 1, 
		p1.flip_h)
end

function animate_player()
	if p1.speed == 0 then
		-- player is idle
		set_player_sprite(0.1, 1,	2)
	else
		--player is moving
		set_player_sprite(0.5, 2, 4)
	end
end

function set_player_sprite(fr, spr_str, spr_end)
	p1.current_spr += fr
		
	if p1.current_spr >= spr_end + 1 then
		p1.current_spr = spr_str
	end
end
-->8
-- attack - fireballs

-- attack cooldown


-- lifetime ends when off 
-- screen or hits an enemy

-- no aoe for now

-- not guided - move up the
-- screen in a straight line

function att_init()
	atts = {}
	
	fb_cooldown = 10
	fb_cooldown_ctr = 0
	fb_speed = 15
	fb_dmg = 2
	
	-- fireball sprtes start/end
	fb_spr_str = 16
	fb_spr_end = 18
	fb_spr_fr = 0.5
end

function cast_fireball()
	-- this will return a 
	-- new fireball
	
	-- set cooldown counter
	fb_cooldown_ctr = fb_cooldown
	
	local fb = {
		x = p1.x,
		y = p1.y - 8,
		cspr = fb_spr_str, -- current sprite
	}
	
	-- add fb to attacks array
	add(atts, fb)
end

function att_update()
	
	-- handle cooldown
	if fb_cooldown_ctr > 0 then
		fb_cooldown_ctr -= 1
	end

	if fb_cooldown_ctr == 0 
		  and btnp(🅾️) then
			cast_fireball()
	end
	
	for fb in all(atts) do
		-- for each fireball in
		-- our attacks array
		
		-- setting y
		fb.y -= fb_speed
		-- set sprite
		fb.cspr += fb_spr_fr
		
		if fb.cspr >= fb_spr_end + 1 then
			fb.cspr = fb_spr_str 
		end
		
		if fb.y <= -8 then
			-- if off screen delete
			-- current fireball
			del(atts, fb)
		end
	end
	
end


function att_draw() 
	-- draw each fireball
	for fb in all(atts) do
		spr(fb.cspr, fb.x, fb.y)
	end
end
-->8
-- ghost code

function ghost_init()
	ghosts = {}
	kills = 0 -- counter to track ghost kills

	-- first spawn in 30 frames / 1 second
	gh_spawn_ctr = 30
	
	-- normal ghost base configuration
	gh_speed = 0.25
	gh_health = 3 -- ghosts now take 2 hits to kill
	gh_spr_str = 32
	gh_spr_end = 36
	gh_spr_fr = 0.2
	
	-- alpha ghost base configuration
	alpha_gh_speed = 0.5
	alpha_gh_health = 6
	alpha_gh_spr_str = 7
	alpha_gh_spr_end = 11
end

function spawn_ghost()
	-- default setup for a normal ghost
	local speed = gh_speed
	local hp = gh_health
	local s_str = gh_spr_str
	local s_end = gh_spr_end
	local swh = 2
	local sprs = {32, 34, 36}
	
	-- if player has 20+ kills, there's a 25% chance to spawn an alpha
	if kills % 5 == 0 and kills != 0 and rnd(1) < 100 then
		speed = alpha_gh_speed
		hp = alpha_gh_health
		s_str = alpha_gh_spr_str
		s_end = alpha_gh_spr_end
		swh = 2 
		sprs = {7, 9, 11}
	end

	local g = {
		x = rnd(127 - 8),
		y = -8,
		cspr = 1,
		spr_str = 1, -- hold unique loop limits per ghost instance
		spr_end = 3,
		hp = hp,
		speed = speed,
		swh = swh, -- spr width and hight
		sprs = sprs,
	}
	
	add(ghosts, g)
	reset_ghost_spawn_ctr()
end

function reset_ghost_spawn_ctr()
	-- set a random respawn
	gh_spawn_ctr = rnd(30) + 60
end

function ghost_update()
	gh_spawn_ctr -= 1
	if gh_spawn_ctr <= 0 then
		-- spawn ghost
		spawn_ghost()
	end
	
	for g in all(ghosts) do
		g.y += g.speed
		g.cspr += gh_spr_fr
		
		
		if g.cspr >= g.spr_end + 1 then
				g.cspr = g.spr_str
		end
			
		
		if g.y >= 128 then
			-- triggering game over state instead of just deleting
			game_state = "gameover"
			del(ghosts, g)
		end
	end
	
end

function ghost_draw()
	for g in all(ghosts) do
		spr(g.sprs[flr(g.cspr)], g.x, g.y, g.swh, g.swh)
	end
end
-->8
-- ui code

function ui_init()
	score = 0
end

function ui_update()
	
end

function ui_draw()
	draw_mana_bar()
	draw_score()
end

function draw_score()
	print("score=" ..score, 2, 5)
	print("kills=" ..kills, 2, 13) -- visual confirmation tracker
end

function draw_mana_bar()
	
	local width = 30
	local x1 = 3
	local x2 = x1 + width
	local y1 = 120
	local y2 = y1 + 5
	
	local mana_pct = (fb_cooldown - fb_cooldown_ctr) / fb_cooldown
	local fill = x1 + (width * mana_pct)
	
	
	rectfill(x1, y1, x2, y2, 0)
	rectfill(x1, y1, fill, y2, 1)
	rect(x1 - 1, y1 - 1, x2 + 1, y2 + 1, 7)
	spr(19, x1, y1 - 1)
end

-- decorative dark game over window popup overlay
function draw_game_over()
	-- transparent box over the center of screen
	rectfill(20, 40, 108, 88, 0)
	rect(19, 39, 109, 89, 8) -- red boundary
	
	-- shadow print text
	print("game over", 46, 50, 8) -- red text
	print("game over", 45, 49, 7) -- white text front
	
	print("final score: "..score, 34, 64, 6)
	print("press ❎ to retry", 28, 76, 10)
end
-->8
-- tombstones

function tombstone_init()
	-- sprites
	ts_spr_str = 39
	ts_spr_end = 42
	
	tombstones = {}
end

function spawn_tombstone(x, y)
	local ts = {
		x = x,
		y = y,
		cspr = ts_spr_str,
		dmg = 0,
	}
	
	add(tombstones, ts)
end

function tombstone_update()
	for ts in all(tombstones) do
		if ts.cspr + ts.dmg >= ts_spr_end + 1 then
			del(tombstones, ts)
		end
	end
end

function tombstone_draw()
	for ts in all(tombstones) do
		spr(
			ts.cspr + ts.dmg,
			ts.x, ts.y) 
	end
end
-->8
-- collisions

function handle_collisions()
	ghost_collisions()
	tombstone_collisions()	
end

function ghost_collisions()
	for fb in all(atts) do
		for gh in all(ghosts) do
		
			if is_colliding(fb, gh) then
				del(atts, fb) -- remove fireball on impact
				
				gh.hp -= fb_dmg -- deal damage instead of instant delete
				
				if gh.hp <= 0 then
					spawn_tombstone(gh.x, gh.y)
					del(ghosts, gh)
					score += 5
					kills += 1 -- increment kill tracker
				end
			end
			
		end
	end
end

function tombstone_collisions()
	for fb in all(atts) do
		for ts in all(tombstones) do
		
			if is_colliding(fb, ts) then
				del(atts, fb)
				ts.dmg += 1
				score += 1
			end
			
		end
	end
end


function is_colliding(obja, objb)
 return obja.x < objb.x + 8 and
        obja.x + 8 > objb.x and
        obja.y < objb.y + 8 and
        obja.y + 8 > objb.y
end
