pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- functions

function _init()
var_init()
end

function _update()
base_update()
menu_update()
menu_var_update()
mps_update()
click_update()
end

function _draw()
	round(money)
	arrow_draw()
	menu_draw()
	purchase_draw()
	win_draw()
	x_draw()
	text_draw()
end
