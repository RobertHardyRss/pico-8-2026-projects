-- sprites

cls(10)
map(1)


function text_draw()
		
		print("goal: $32k",
		 85, 122,10)
		print("$"..money,
		 1, 1,11)
		print("$/s:"..mps,
		 1, 9,11)
		print("cd:"..frame2,
		 74, 97,3)
		print("max cd:"..max_frame2,
		 66, 105,3) 
		print("",
		 50, 1,1)
	

end	


function menu_update()

if menu>0 and
   menu2==0 and
frame==max_frame and
		   menu3==0 then

	if btn(⬆️)
	then
		sfx(0)
		frame=0
		menu-=1

// btn ⬆️ end
	end
end
	
	  if 
				 frame==max_frame then
				 if
				 btn(⬇️) and
		   menu2==0 and
		   menu<=2 and
		   menu3==0 then
	  sfx(0)
			frame=0
	 	menu+=1
	 	
// btn ⬇️ end
		end	
// menu end
	end
// func end
end

function arrow_draw()
	
	if
	menu==0 and
	menu2==0 and
	menu3==0
	then
		spr(0, 32, 32) // <
		
	elseif
	menu==1 and
	menu2==0 and
	menu3==0
	then
		spr(0, 32, 56) // <
		
	elseif
	menu==2 and
	menu2==0 and
	menu3==0
	then
		spr(0, 32, 80) // <
	
	elseif
	menu==3 and
	menu2==0 and
	menu3==0
	then
		spr(0, 32, 104) // <
	
//z cursor
		end
	
	if
	menu3==1
	then
		spr(16, 80, 18) // <
	
	end
end

