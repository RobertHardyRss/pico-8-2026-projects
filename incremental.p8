 print(""..button2,
		 6, 62,11)
		end	
		
		spr(44, -2, 84) // $
print("3.5k",
		 6, 86,3)
		 print("+100 $/s",
		 2, 97,3)	
	if money>=button3
	then
	
	spr(40, 0,  80)
