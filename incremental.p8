function win_draw()

	if money>=32000 then

 	print("you got 32k and won!",
       25,50,10)
       
    mps=0
    money=32000
       
 	end
 	
end



function x_draw()

if menu2==1 and
	menu3==0 then

 spr(72, 80, 64)
 spr(72, 88, 72)
 spr(72, 72, 56)
 spr(72, 88, 56)
 spr(72, 72, 72)
 // x cursor
 else 
 
 // spr
 
 end


end

-->8
-- increment

function base_update()
cls(6)
map()

	money+=gr
	money=round(money)
	
	
	
	
end


function click_update()
	
	if btn(⬆️) and
	   menu2==1 and
	   frame==max_frame then
	   
	   frame=0
	   menu3=1
	   sfx(0)
	  end
	
	if btn(⬇️) and
	   menu2==1 and
	   frame==max_frame then
	   
	   menu3=0
	   frame=0
	   sfx(0)
	  end
	
	
	if btn(➡️) and
	   menu3==0 and
	   frame==max_frame then
	
		menu2=1
		frame=0
		sfx(0)
	end
	
	
	
	if btn(⬅️) and 
	   menu3==0 and
	   frame==max_frame  then
	
	 menu2=0
	 sfx(0)
	 frame=0
	end
	
end



function round(num)

	local m = 10^(0)
	return abs(flr(num*m+0.5)/m)

end


function purchase_draw()
	
	if btn(🅾️) and
			 menu==0 and
			 menu2==0 and
				money>=button1 and
				frame3==max_frame3 then
		
			money-=button1
			mps+=2
			frame3=0
			sfx(1)
	end
	
	
		if btn(🅾️) and
			 menu==1 and
			 menu2==0 and
				money>=button2 and
				frame3==max_frame3 then
		
			money-=button2
			mps+=10
			frame3=0
			sfx(1)
	end
	
	
			if btn(🅾️) and
			 menu==2 and
			 menu2==0 and
				money>=button3 and
				frame3==max_frame3 then
		
			money-=button3
			mps+=100
			frame3=0
			sfx(1)
	end
	
	
			if btn(🅾️) and
			 menu==3 and
			 menu2==0 and
				money>=button4 and
				frame3==max_frame3 then
		
			money-=button4
			mps+=350
			frame3=0
			sfx(1)
	end
	
	if btn(🅾️) and
			 menu3==1 and
				money>=buttons and
				frame3==max_frame3 and
				buttons_purchased<5 then
		
			money-=buttons
			frame2=0
			max_frame2-=2
			frame3=0
			buttons_purchased+=1
			buttons*=1.5
			buttons+=2000
			sfx(2)
			
			if buttons_purchased==4 then
			 buttons=20000
			 end
			if buttons_purchased==5 then
				buttons=32001
				end
	end
	
end
-->8
-- varibles

function var_init()

// current money
	money=0
	
// money per second
	mps=20
	
// 1 sec divided by 30 frames
	gr=0
	
// current button selected
	menu=0
	
// button press for money
	menu2=0
	
// button speed upg
	menu3=0
		
// time between each button
	frame=0

// clicker
 frame2=0


// purchase
 frame3=0
	
// purchase
 max_frame3=15
 	
// menu
 max_frame=8
 
// clicker
 max_frame2=15
 
// btn 1 price
 button1=100
 
 button2=550
 
 button3=3500
	
	button4=9000
	
// speed button
	buttons=1500
	
// goes up every buttons-
// bought, maxes at 5
	buttons_purchased=0
	
end


function mps_update()
	
	if btn(❎) and
	   frame2==max_frame2 and
	   menu2==1 and
	menu3==0 then
		money+=mps/2
		frame2=0
		sfx(3)
		end
	
end


function menu_var_update()
	
	if frame<max_frame
	then
		
		frame+=1
		
	end


	if frame2<max_frame2
	then
		
		frame2+=1
		
	end
	
	
	if frame3<max_frame3
	then
		
		frame3+=1
		
	end
	
// menu var end
end


