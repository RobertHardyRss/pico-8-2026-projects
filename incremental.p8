 //edge
 print("3.5k",
		 6, 86, 11)
		end
 print("9k",
		 6, 110, 3)
		spr(44, -2, 108) // $
		print("+350 $/s",
		 2, 121,3)	
	if money>=button4
	then
	
	spr(40, 0,  104)
