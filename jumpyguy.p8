pico-8 cartridge // http://www.pico-8.com
version 43
__lua__


function _init()
	x=20
	y=113
	
	xmin=0
	xmax=120
	
	ymin=5
	ymax=113
	
	y_vel=0
	grav=0.5
	jump_pwr=-5
	is_grded=true
	
 cam_x=0
	
	-- player dimensions
  ply_x = 0
  ply_y = 0
  ply_w = 8
  ply_h = 8
  ply_sprite = 4
  
  -- obstacle dimensions
  obs_x=128
	 obs_y=113
  obs_w=8
  obs_h=8
  obs_spr=5
  obs_spd=3.5
  
 -- game
 score=0
 gm_ovr=false
 --collisions
 obs_types = {
  {spr=5,w=8,h=8,y=113, hit_w=8,hit_h=8}, 
  {spr=6,w=8,h=16,y=106, hit_w=8,hit_h=16}, 
  {spr=7,w=24,h=16,y=106, hit_w=24,hit_h=8}, 
  {spr=55,w=16,h=8,y=113, hit_w=16,hit_h=8} 
 }
 
 spwn_obs()
	
end --end of _init()

function _update()
 
 --track score
 if not gm_ovr then
  score+=1
  cam_x+=1
 end
 
 if not gm_ovr then
  -- horizontal movement
  if btn(➡️) then x += 2 end 
  if btn(⬅️) then x -= 2 end
  
  if x < 0 then x = 0 end
  if x > 120 then x = 120 end
  
  -- jump mechanics
  if btnp(⬆️) and is_grded then 
   y_vel = jump_pwr
   is_grded = false
  end
  
  y_vel += grav
  y += y_vel
  
  if y >= 112 then 
   y = 112
   y_vel = 0
   is_grded = true
  end 
  
  -- obstacle movement
  obs_x -= obs_spd
  if obs_x<-current_obs_w then
   obs_x = 128
   spwn_obs()
  end

  -- collision check
  if collide(x, y,
   ply_w, ply_h,
   obs_x,current_obs_y,
   	 current_obs_w,
   		 current_obs_h) then
   gm_ovr = true
  end

 else
  -- restart
  if btnp(❎) then
   _init()
  end
 end


 
end --end of _update()

function _draw()

function _draw()
  if not gm_ovr then
    -- durimg game
   cls(12)
    
   camera(cam_x, 0)
   map(0, 0, 0, 0, 128, 32)
   spr(4, x + cam_x, y)
   spr(current_obs_spr,
    obs_x + cam_x, current_obs_y,
    current_obs_w / 8,
    current_obs_h / 8)
    
   camera(0, 0)
   local 
   display_score =
    flr(score / 40.5)
   print("score: "
   ..display_score, 4, 10, 8)

  else
    -- game over screen
   cls(0)
   camera(0, 0)
    
   local display_score =
    flr(score / 40)
    
   print("game over",
    46, 45, 8)
    
   print("final score: "
   ..display_score, 34, 55, 10)
   
   print("press x to restart",
    24, 70, 7)
  end 
end

end --end of _draw()



-->8
function collide(x1, y1, w1,
				 h1, x2, y2, w2, h2)
				 
 return x1 < x2 + w2 and
        x1 + w1 > x2 and
        y1 < y2 + h2 and
        y1 + h1 > y2
end

function spwn_obs()
	local type =
 obs_types[flr(rnd(#obs_types))
  + 1]
 
 current_obs_spr = type.spr
 current_obs_w   = type.w
 current_obs_h   = type.h
 current_obs_y   = type.y

end
