function portal_check()
	--  room 1 logic
	if p1.x + 8 > trigger_up.x1 and p1.x < trigger_up.x2 and
	   p1.y + 8 > trigger_up.y1 and p1.y < trigger_up.y2 then
		p1.y -= 110
		room_min_y = 367
		room_max_y = 306
		room_min_x = 0
		room_max_x = 112
		p1.y_speed = 0 
		sfx(0)
	end
	
	if p1.x + 8 > trigger_down.x1 and p1.x < trigger_down.x2 and
	   p1.y + 8 > trigger_down.y1 and p1.y < trigger_down.y2 then
		p1.y += 105
		room_min_y = 474
		room_max_y = 504
		room_min_x = 0
		room_max_x = 1017
		p1.y_speed = 0
		sfx(0)
	end

	--  room 2 logic 
	if room2_unlocked then
		if p1.x + 8 > trigger_up_right.x1 and p1.x < trigger_up_right.x2 and
		   p1.y + 8 > trigger_up_right.y1 and p1.y < trigger_up_right.y2 then
			p1.y -= 110
			room_min_y = 367
			room_max_y = 306
			room_min_x = 192
			room_max_x = 304
			p1.y_speed = 0 
			sfx(0)
		end
	end
	
	if p1.x + 8 > trigger_down_right.x1 and p1.x < trigger_down_right.x2 and
	   p1.y + 8 > trigger_down_right.y1 and p1.y < trigger_down_right.y2 then
		p1.y += 105
		room_min_y = 474
		room_max_y = 504
		room_min_x = 0
		room_max_x = 1017
	end	
	
	--  room 3 logic 
	if room3_unlocked then
		if p1.x + 8 > trigger_up_rightt.x1 and p1.x < trigger_up_rightt.x2 and
		   p1.y + 8 > trigger_up_rightt.y1 and p1.y < trigger_up_rightt.y2 then
			p1.y -= 110
			room_min_y = 367
			room_max_y = 306
			room_min_x = 384
			room_max_x = 496
			p1.y_speed = 0 
			sfx(0)
		end
	end
	
	if p1.x + 8 > trigger_down_rightt.x1 and p1.x < trigger_down_rightt.x2 and
	   p1.y + 8 > trigger_down_rightt.y1 and p1.y < trigger_down_rightt.y2 then
		p1.y += 105
		room_min_y = 474
		room_max_y = 504
		room_min_x = 0
		room_max_x = 1017
		p1.y_speed = 0
		sfx(0)
	end

	--  room 4 logic
	if room4_unlocked then
		if p1.x + 8 > trigger_up_righttt.x1 and p1.x < trigger_up_righttt.x2 and
		   p1.y + 8 > trigger_up_righttt.y1 and p1.y < trigger_up_righttt.y2 then
			p1.y -= 110
			room_min_y = 367
			room_max_y = 282
			room_min_x = 384+192
			room_max_x = 496+192
			p1.y_speed = 0 
			sfx(0)
		end
	end
	
	if p1.x + 8 > trigger_down_righttt.x1 and p1.x < trigger_down_righttt.x2 and
	   p1.y + 8 > trigger_down_righttt.y1 and p1.y < trigger_down_righttt.y2 then
		p1.y += 105
		room_min_y = 474
		room_max_y = 504
		room_min_x = 0
		room_max_x = 1017
		p1.y_speed = 0
		sfx(0)
	end
	
	--  room 5 logic 
	if room5_unlocked then
		if p1.x + 8 > trigger_up_rightttt.x1 and p1.x < trigger_up_rightttt.x2 and
		   p1.y + 8 > trigger_up_rightttt.y1 and p1.y < trigger_up_rightttt.y2 then
			p1.y -= 110
			room_min_y = 367
			room_max_y = 282
			room_min_x = 384+384
			room_max_x = 496+384
			p1.y_speed = 0 
			sfx(0)
		end
	end
	
	if p1.x + 8 > trigger_down_rightttt.x1 and p1.x < trigger_down_rightttt.x2 and
	   p1.y + 8 > trigger_down_rightttt.y1 and p1.y < trigger_down_rightttt.y2 then
		p1.y += 105
		room_min_y = 474
		room_max_y = 504
		room_min_x = 0
		room_max_x = 1017
		p1.y_speed = 0
		sfx(0)
	end
	
	--  room 6 logic
	if room6_unlocked then
		if p1.x + 8 > trigger_up_righttttt.x1 and p1.x < trigger_up_righttttt.x2 and
		   p1.y + 8 > trigger_up_righttttt.y1 and p1.y < trigger_up_righttttt.y2 then
			p1.x += 75
			room_min_y = 367
			room_max_y = 282
			room_min_x = 384
			room_max_x = 1000
			p1.y_speed = 0 
			sfx(0)
		end
	end
	
	if p1.x + 8 > trigger_down_righttttt.x1 and p1.x < trigger_down_righttttt.x2 and
	   p1.y + 8 > trigger_down_righttttt.y1 and p1.y < trigger_down_righttttt.y2 then
