		sfx(0)
	end

	--  room 7 logic
	if room7_unlocked then
		if p1.x + 8 > trigger_up_rightttttt.x1 and p1.x < trigger_up_rightttttt.x2 and
		   p1.y + 8 > trigger_up_rightttttt.y1 and p1.y < trigger_up_rightttttt.y2 then
			p1.y = 205
			
			
			room_min_x = 712
