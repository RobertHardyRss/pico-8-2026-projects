-- loot / inventory system 

lootables = {}     
inventory = {}     

function loot_init()
	
	lootables = {}
	inventory = {}
	
	-- spawn lootable objects
	add_lootable(0, 311, 27)
	add_lootable(10, 311, 27)
	add_lootable(30, 311, 19)
	add_lootable(60, 311, 27)
	add_lootable(90, 311, 27)
	add_lootable(10, 330, 27)
	add_lootable(30, 330, 38)
	add_lootable(60, 330, 27)
	add_lootable(90, 330, 27)
	add_lootable(192, 311, 27)
	add_lootable(255, 311, 20)
	add_lootable(220, 311, 27)
	add_lootable(240, 311, 27)
	add_lootable(192, 330, 27)
	add_lootable(215, 330, 35)
	add_lootable(250, 330, 27)
	add_lootable(280, 330, 27)
	add_lootable(414, 311, 27)
	add_lootable(440, 311, 21)
	add_lootable(460, 311, 27)
	add_lootable(430, 311, 28)
	add_lootable(417, 330, 27)
	add_lootable(425, 330, 27)
	add_lootable(450, 330, 33)
	add_lootable(470, 330, 27)
	add_lootable(580, 330, 27)
	add_lootable(600, 330, 27)
	add_lootable(580, 350, 27)
	add_lootable(600, 350, 27)
	add_lootable(590, 320, 22)
	add_lootable(610, 330, 27)
end

function add_lootable(_x, _y, _item)
	local loot = {
		x = _x,
		y = _y,
		item = _item,
		sp = 16,        
		looted = false,
		w = 8,          
		h = 8           
	}
	add(lootables, loot)
end

function check_loot_interaction()
	-- check collision against all active loot 
	for l in all(lootables) do
		if not l.looted then
			-- overlap box collision check (this is what google said to do)
			if p1.x + 8 >= l.x - 4 and
			   p1.x <= l.x + l.w + 4 and
			   p1.y + 8 >= l.y - 4 and
			   p1.y <= l.y + l.h + 4 then
				
				-- change sprite state and mark as looted
				l.sp = 17 
				l.looted = true
				
				-- add the item tied specifically to this chest to inventory
				add(inventory, l.item)
				break 
			end
		end
	end
end

-- scans inventory to check if player holds a specific item id
function has_item(_id)
	for item in all(inventory) do
		if item == _id then return true end
	end
	return false
end

-- solid collision checking to stop the player from walking through unlooted objects
function check_loot_collision(_x, _y)
	for l in all(lootables) do
		if not l.looted then
			if _x + 7 >= l.x and
			   _x <= l.x + 7 and
			   _y + 7 >= l.y and
			   _y <= l.y + 7 then
				return true 
			end
		end
	end
	return false 
end

-- --- ui rendering helper ---
function draw_inventory_ui()
	local counts = {}
	local order = {}
	
	for item in all(inventory) do
		if counts[item] == nil then
			counts[item] = 1
			add(order, item)
		else
			counts[item] += 1
		end
	end
	
	-- grid layout variables
	local start_x = 70
	local start_y = 0
	local row_max = 4        -- maximum items per row before breaking
	local col_spacing = 14   -- space horizontally between icons
	local row_spacing = 10   -- space vertically between lines
	
	for i = 1, #order do
		local item = order[i]
		
		-- compute grid position using 0-indexed values
		local col = (i - 1) % row_max
		local row = (i - 1) \ row_max -- integer division operator
		
		local item_x = start_x + (col * col_spacing)
		local item_y = start_y + (row * row_spacing)
		
		-- draw the item icon
		spr(item, item_x, item_y)
		
		-- draw stack count slightly shifted below the icon
		if counts[item] > 1 then
			print(counts[item].."x", item_x + 1, item_y + 3, 0)
		end
	end
end

