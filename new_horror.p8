	if p1.x + 8 > trigger_down_rightttttt.x1 and p1.x < trigger_down_rightttttt.x2 and
	   p1.y + 8 > trigger_down_rightttttt.y1 and p1.y < trigger_down_rightttttt.y2 then
		p1.y = 287 
		room_min_y = 0
		room_max_y = 9994
		room_min_x = 0
		room_max_x = 1017
		p1.y_speed = 0
		sfx(0)
	end
end

-- helper to draw locked visual
function draw_portals_ui()
	if not room2_unlocked then spr(23, 224, 465) end
	if not room3_unlocked then spr(24, 416, 465) end
	if not room4_unlocked then spr(25, 608, 465) end
	if not room5_unlocked then spr(26, 800, 465) end
	if not room6_unlocked then spr(29, 880, 317) end
	if not room7_unlocked then spr(108, 775, 278) end
end

function check_gate_interaction()
	if not room2_unlocked then
		if p1.x + 8 >= 224 - 6 and p1.x <= 224 + 8 + 6 and
		   p1.y + 8 >= 465 - 6 and p1.y <= 465 + 8 + 6 then
			if has_item(19) then room2_unlocked = true sfx(0) end
		end
	end
	
	if not room3_unlocked then
		if p1.x + 8 >= 416 - 6 and p1.x <= 416 + 8 + 6 and
		   p1.y + 8 >= 465 - 6 and p1.y <= 465 + 8 + 6 then
			if has_item(20) then room3_unlocked = true sfx(0) end
		end
	end

	if not room4_unlocked then
		if p1.x + 8 >= 608 - 6 and p1.x <= 608 + 8 + 6 and
		   p1.y + 8 >= 465 - 6 and p1.y <= 465 + 8 + 6 then
			if has_item(21) then room4_unlocked = true sfx(0) end
		end
	end

	if not room5_unlocked then
		if p1.x + 8 >= 800 - 6 and p1.x <= 800 + 8 + 6 and
		   p1.y + 8 >= 465 - 6 and p1.y <= 465 + 8 + 6 then
			if has_item(22) then room5_unlocked = true sfx(0) end
		end
	end

	if not room6_unlocked then
		if p1.x + 8 >= 880 - 6 and p1.x <= 880 + 8 + 6 and
		   p1.y + 8 >= 317 - 6 and p1.y <= 317 + 8 + 6 then
			if has_item(28) then room6_unlocked = true sfx(0) end
		end
	end
	
	if not room7_unlocked then
		if p1.x + 8 >= 773 - 6 and p1.x <= 785 + 8 + 6 and
		   p1.y + 8 >= 278 - 6 and p1.y <= 286 + 8 + 6 then
			if has_item(38) then room7_unlocked = true sfx(0) end
		end
	end
end

