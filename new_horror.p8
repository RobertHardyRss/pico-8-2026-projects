-- death screen system

is_dead = false

function draw_death_screen()
	
	camera(0, 0)
	cls(0) 
	
	local txt = "as you step over the mangled corpse its bones and flesh crackles as its blood form tendrils and that reach out entangling you before slowly squeezing. you feel your bones crack, flesh squelch, eyes start to pop from your skull and the tendrils start to make their way in your ears, eyes, nose, and mouth."
	
	print(txt, 7, 6, 8, 114)
	
	local blink = flr(time() * 2) % 2
	local prompt = "[ press x to restart ]"
	
	if blink == 0 then
		print(prompt, 64 - (#prompt * 2), 116, 7) -- color 7 is crisp white
	end
end

function reset_game()
	is_dead = false
	player_init() 
	traps_init()
end

