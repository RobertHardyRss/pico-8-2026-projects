-- --- player ---

function player_init()

	p1 = {
		x = 0,
		y = 504,       
		x_speed = 0,   
		y_speed = 0,   
		acc = 0.5,     
		max_speed = 3,
		
		-- animation variables
		sp = 1,        
		anim_timer = 0, 
		flip_x = false 
	}
	
	-- camera position tracking variables
	cam_x = 0
	cam_y = 0
	
	-- default player clamping boundaries (vertical)
	room_min_y = 474
	room_max_y = 504

	-- default player clamping boundaries (horizontal)
	room_min_x = 0
	room_max_x = 1017
	
	-- initialize portals handled in tab 2
	portal_init()

	-- initialize dynamic lootable items
	loot_init()
	traps_init()
	is_dead = false
end

function player_update()
	  
	if is_dead then 
	
		if btnp(❎) then reset_game() end
		return 
	end

	local moving = false
	
	-- --- horizontal movement (left / right) ---
	if btn(⬅️) then
		p1.x_speed -= p1.acc
		moving = true
		p1.flip_x = true  
	elseif btn(➡️) then
		p1.x_speed += p1.acc
		moving = true
		p1.flip_x = false 
	else
		p1.x_speed *= 0.8
		if abs(p1.x_speed) < 0.1 then p1.x_speed = 0 end
	end
	
	-- --- vertical movement (up / down) ---
	if btn(⬆️) then
		p1.y_speed -= p1.acc
		moving = true
	elseif btn(⬇️) then 
		p1.y_speed += p1.acc
		moving = true
	else
		p1.y_speed *= 0.8
		if abs(p1.y_speed) < 0.1 then p1.y_speed = 0 end
	end
	
	p1.x_speed = mid(-p1.max_speed, p1.x_speed, p1.max_speed)
	p1.y_speed = mid(-p1.max_speed, p1.y_speed, p1.max_speed)
	
	-- check horizontal collision before applying x movement
	if not check_loot_collision(p1.x + p1.x_speed, p1.y) then
		p1.x += p1.x_speed
	else
		p1.x_speed = 0
	end
	
	-- check vertical collision before applying y movement
	if not check_loot_collision(p1.x, p1.y + p1.y_speed) then
		p1.y += p1.y_speed
	else
		p1.y_speed = 0
	end
	
	-- --- interaction / looting / gate input
	if btnp(❎) then
		check_loot_interaction()
		check_gate_interaction()
	end
	
	portal_check()
	
	check_trap_collisions()
	
	p1.x = mid(room_min_x, p1.x, room_max_x)
	
	-- dynamic height clamp (restored back to your original code layout)
	p1.y = mid(room_min_y, p1.y, room_max_y)
	
	-- --- camera tracking logic
	cam_x = p1.x - 60
	cam_y = p1.y - 60
	
	cam_x = mid(0, cam_x, 896)
	cam_y = mid(0, cam_y, 384)
	
	-- --- animation logic ---
	p1.anim_timer += 1
	
	if btn(⬆️) then
		p1.sp = 5
	elseif btn(⬅️) or btn(➡️) then
		if flr((p1.anim_timer % 12) / 6) == 0 then
			p1.sp = 3
		else
			p1.sp = 4
		end
	else
		if flr((p1.anim_timer % 30) / 15) == 0 then
			p1.sp = 1
		else
			p1.sp = 2
		end
	end
end

function player_draw()

	if is_dead then
		draw_death_screen()
		return
	end

	cls() 
	
	-- set camera offset before drawing anything else
	camera(cam_x, cam_y)
	
	map(0, 0, 0, 0, 128, 64)
	
	draw_portals_ui()
	
	draw_traps()
	
	for l in all(lootables) do
		spr(l.sp, l.x, l.y)
	end
	 
	spr(p1.sp, p1.x, p1.y, 1, 1, p1.flip_x, false)
	
	-- reset camera offset
	camera(0, 0)
	print("p1 x:"..flr(p1.x).." y:"..flr(p1.y), 0, 0, 12)
	
	draw_inventory_ui()
end

