--traps

traps = {}

function traps_init()
	traps = {}
	
	
	add_trap(70, 491, 37)
end

function add_trap(_x, _y, _sp)
	local t = {
		x = _x,
		y = _y,
		sp = _sp,
		w = 8,
		h = 8
	}
	add(traps, t)
end

function check_trap_collisions()
	
	if is_dead then return end
	
	for t in all(traps) do
		
		if p1.x + 8 > t.x and p1.x < t.x + t.w and
		   p1.y + 8 > t.y and p1.y < t.y + t.h then
			
			is_dead = true
			break
		end
	end
end

function draw_traps()
	for t in all(traps) do
		spr(t.sp, t.x, t.y)
	end
end

