function portal_init()
	room2_unlocked = false
	room3_unlocked = false
	room4_unlocked = false
	room5_unlocked = false
	room6_unlocked = false
	room7_unlocked = false
	
	-- room 1 triggers
	trigger_up = {
		x1 = 30, x2 = 41, 
		y1 = 465, y2 = 473
	}
	
	trigger_down = {
		x1 = 30, x2 = 41, 
		y1 = 377, y2 = 380
	}

	-- room 2 triggers
	trigger_up_right = {
		x1 = 222, x2 = 233, 
		y1 = 465, y2 = 473
	}
	
	trigger_down_right = {
		x1 = 222, x2 = 233, 
		y1 = 377, y2 = 380
	}
	-- room 3 triggers
