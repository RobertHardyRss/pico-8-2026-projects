--apple code
function apple_init()
	apples = {}
	apple = {}
	apple_spr_str = 33
	apple_amount = 0
	apple_obs = 34
	apple_score = 0
end	

function spawn_apple()
	local a = {
		x = rnd(15) * 8,
		y = rnd(15) * 8,
	}
		apple_amount += 1
		add(apples, a)
				
end

function spawn_obs()

local b = {
		x = rnd(8) * 16,
		y = rnd(8) * 16,
	}
	
	add(apple, b)

end
function apple_draw()
	
	for a in all(apples) do
		spr(apple_spr_str, a.x, a.y)
	end
	
	for b in all(apple) do
		spr(apple_obs, b.x, b.y)
	end
	
	print("score="..apple_score, 5, 5, 0)

end		

function apple_update()
   
  if apple_amount >= 1 then
    
   return
     
 end
	
  spawn_apple() 
  spawn_obs()

end

-->8
--collisons
function collisions()
	
	apple_collisions()

end
	
function apple_collisions()
	
	for a in all(apples) do

		if is_colliding(a, snk) then
				del(apples, a)
			 apple_amount -= 1
			 apple_score += 1
			 snk.cur_spr += 16
		end
	
	for b in all(apple) do
	
		if is_colliding(snk, b) then
				del(apple, b)
				end_game = true
			
			end
		end
	end
end
	
	function is_colliding(obja, objb)
 return obja.x < objb.x + 4 and
        obja.x + 4 > objb.x and
        obja.y < objb.y + 4 and
        obja.y + 4 > objb.y
end
