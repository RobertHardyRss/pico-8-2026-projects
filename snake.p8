-- snake code

function snake_init()
	snk = {
		speed = 1,
		x = 56,
		y = 55,
		cur_spr = 4,
		direction = "➡️",
	}
end

function snake_update()
	if btnp(⬅️) then
		
		snk.direction = "⬅️"
		snk.cur_spr = 2
	elseif btnp(➡️) then
		
		snk.direction = "➡️"
		snk.cur_spr = 4
	elseif btnp(⬇️) then 
					
		snk.direction = "⬇️"
		snk.cur_spr = 3
	elseif	btnp(⬆️) then
	 				
		snk.direction = "⬆️"
		snk.cur_spr = 1
	end
	
	if snk.direction == "⬅️" then
		snk.x -= snk.speed

	elseif snk.direction == "➡️" then
		snk.x += snk.speed
		
	elseif snk.direction == "⬇️" then 
		snk.y += snk.speed
		
	elseif	snk.direction == "⬆️" then
	 snk.y -= snk.speed
	end	
	
	if snk.cur_spr > 16 then
	
		snk.cur_spr -= 16
	
	end

end
	
function snake_grow()
	
		add(snk, s)
		
end


function snake_draw()
	spr(snk.cur_spr, snk.x, snk.y)
	
end
