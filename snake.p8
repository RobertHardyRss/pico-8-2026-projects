pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 end_game = false
 music(0) -- starts the music loop once at launch
 snake_init() 
	apple_init()
end

function _update()
 if end_game == false then
 apple_update()
 snake_update()
 collisions()
	end
end

function _draw()
 
 if end_game == false then
 cls(12)
	snake_draw()
	apple_draw()

else
 
 	cls(0)
			print("game over", 45, 60, 7)
			print("your final score was "..apple_score, 20, 50, 7)		

	end
end
